# ============================================================================
# VAT public configuration  —  SAFE TO COMMIT (VPN-internal addresses only)
# ============================================================================
# This file is the single source of public, non-secret config. It is consumed
# two ways and is valid for both:
#   * the Makefile        →  `include vat.env` (the control file exports these)
#   * shell scripts       →  `set -a; . ./vat.env; set +a`
#
# Edit these to match your deployment, commit, and every machine agrees.
# (KEY=value only, no spaces around '='; '#' starts a comment.)

# ── Zenoh router : the hub every process connects to ────────────────────────
# Public VPN IP of the host that runs the router (`make router`).
# IMPORTANT: the mapping server may live in a DIFFERENT datacenter than the
# router, so this must be the router's reachable address — never localhost.
ROUTER_IP=100.76.214.80
# ROUTER_IP=100.87.118.34
ROUTER_PORT=7447

# Endpoint that clients/peers dial (mapping server, robot container, client).
ZENOH_ROUTER=tcp/${ROUTER_IP}:${ROUTER_PORT}
ZENOH_CONNECT=tcp/${ROUTER_IP}:${ROUTER_PORT}
# What the router process itself binds to (on the router host).
ZENOH_LISTEN=tcp/0.0.0.0:${ROUTER_PORT}

# ── Identity / key schema ───────────────────────────────────────────────────
ROBOT_NAME=go2
SERVER_PREFIX=server/prism
# DDS interface the container's bridge binds to reach the Go2 MCU (which
# publishes /sportmodestate). Leave empty to AUTO-DETECT (prefers the NIC on
# the Unitree subnet 192.168.123.x); set explicitly if auto-detect picks wrong.
# Find it on the robot with:  ip -br addr
NET_IFACE=
# unitree_ros2 git ref (branch/tag) for the bridge's message types, built into
# the container image. If /sportmodestate shows [no data] after a rebuild, your
# firmware's message layout differs from this version — check the host with
#   ros2 interface show unitree_go/msg/SportModeState
# and pin the matching unitree_ros2 branch/tag here, then rebuild.
UNITREE_ROS2_REF=master

# ── PRISM sliding window (mapping server) ───────────────────────────────────
# Window of TRANSMITTED frames (i.e. THROTTLE_FPS rate, NOT CAMERA_FPS) that
# PanoVGGT infers per submap. OVERLAP frames are shared with the previous window
# (chaining/anchoring). 12/4 ≈ 2.7 s of footage at THROTTLE_FPS=3 → lower latency
# and more frequent submaps than 16/4 (slightly less per-window context).
WINDOW_SIZE=12
OVERLAP=4
# TSDF voxel size (m). 0.03 (3 cm) ≈ half the points of 2 cm → smaller clouds,
# lower latency/bandwidth. Drop to 0.02 for finer geometry at higher cost.
VOXEL_SIZE=0.025
# Streamed cloud density (m), decoupled from the TSDF voxel above. Coarser = less
# bandwidth; the mapper stays fine for internal quality. Set = VOXEL_SIZE to disable.
STREAM_VOXEL_M=0.05
# Stream decimation mode: none | voxel_centroid | voxel_center | stride
STREAM_DECIMATE_MODE=voxel_centroid
STREAM_STRIDE=3
# Backlog guard: drop stale frames + resync if the server falls this far behind
BACKLOG_MAX_FRAMES=45
BACKLOG_KEEP_FRAMES=36
# ── Cloud bandwidth ─────────────────────────────────────────────────────────
# Ceiling-plane clip: drop points above this world-Z height (toy-box top-down
# view + bandwidth). EMPTY = OFF (send the whole cloud, no slicing). Live-settable
# over Zenoh: zenoh put --key 'server/prism/config/ceiling_z' --payload 2.2
# (send 'off' to disable again).
CEILING_Z=
# Draco point-cloud compression (server encodes, client auto-decodes): position
# quantisation bits (10 ≈ 1-2 cm over a room, fine for 3 cm voxels) and level
# (10 = max ratio). Lower bits = smaller; raise for finer maps.
DRACO_QUANT_BITS=10
DRACO_LEVEL=10
# ── Metric-scale stability (fixes layered ground + live-viewer ghosting) ────
# See docs/streaming_poc.md → "Online metric scale".
# Anchor the map's metric scale to the MEDIAN floor scale of the first N confident
# windows instead of locking to a (possibly outlier) first window. 1 = old
# lock-on-first-window behaviour.
SCALE_WARMUP_WINDOWS=3
# Depth integration scale. 0 (default) = integrate all depth at the single
# committed scale, exactly like the offline gradio pipeline (camera height only
# anchors scale on the first scene; PanoVGGT carries it after). 1 = re-scale each
# window's depth to its own floor estimate — pins the floor flat but the ~±4%
# per-window floor noise makes WALLS jitter/ghost. Only enable for a genuine
# monotonic floor climb across very different scenes.
DEPTH_SCALE_FROM_FLOOR=0
# Pose-correction safety (avatar back-propagation). See docs/streaming_poc.md →
# "Pose correction stability".
#  * outlier gate: reject a correction implying travel faster than this (m/s)
#    since the last one, plus a fixed margin (m);
CORRECTION_MAX_SPEED=2.5
CORRECTION_JUMP_MARGIN=0.75
#  * deadband: a correction within this distance/angle of the last published one
#    is treated as VGGT still-scene noise and NOT republished, so a stationary
#    robot's avatar stops twitching on every green correction. Raise if it still
#    jitters when still; lower if the avatar lags small real moves.
CORRECTION_DEADBAND_M=0.06
CORRECTION_DEADBAND_DEG=3.0
# Cap points in the STREAMED snapshot (full-res still available via the on-demand
# 'pcd_snapshot' query / make fetch_pcd). Keeps the uplink from saturating.
CLOUD_STREAM_MAX_POINTS=60000

# ── Camera: RICOH Theta X over UVC (robot) ──────────────────────────────────
# (The sharpness window is tuned live over Zenoh, not here, to avoid a name
#  clash with the mapping server's PRISM window — see docs/streaming_poc.md.)
THROTTLE_FPS=3.0
JPEG_QUALITY=85
CAMERA_FPS=30.0

# Real-time transmit size. The robot captures at THETA_MODE, picks the sharpest
# frame, then DOWNSCALES to this for the live Zenoh stream (PanoVGGT input).
# Full-res twins of the same frames go to the archive below (same seq/ts/height).
TRANSMIT_WIDTH=1036
TRANSMIT_HEIGHT=518

# v4l2 device exposing the Theta UVC stream (fed by `make theta-uvc`). RealSense
# owns /dev/video0..N, so this is /dev/video10 (match VIDEO_NR in theta_uvc.sh).
THETA_DEVICE=/dev/video10
# Frozen-stream watchdog (s): if the captured frame is byte-identical for this
# long the camera/feed is treated as dead — the container stops publishing the
# stale frame and reopens the capture, recovering automatically when you reboot
# the camera and re-run `make theta-uvc` (no robot-docker restart). 0 disables.
STALE_TIMEOUT_S=2.5
# Camera capture/stream resolution: 2K (1920x960) or 4K (3840x1920). 4K gives the
# full-res archive its detail but needs a Jetson that can HW-decode 4K H.264
# (Xavier/Orin OK; Nano cannot). Drop to 2K if `make theta-uvc` stalls at 4K.
THETA_MODE=4K
# Advanced: a full GStreamer pipeline (needs OpenCV built with GStreamer +
# gstthetauvc). If set, it overrides THETA_DEVICE. Leave empty otherwise.
THETA_GST_PIPELINE=

# ── Full-res frame archive (robot) ──────────────────────────────────────────
# Each transmitted frame also gets its FULL-RES (THETA_MODE) twin written to a
# local SQLite-indexed archive, tagged with the SAME seq / timestamp / camera
# height, for offline reconstruction (Gaussian splats, NeRF, …). The server can
# fetch any full-res frame on demand by seq. Oldest frames evicted first (FIFO).
ARCHIVE_ENABLE=true
# Archive path INSIDE the container; ARCHIVE_DIR_HOST is bind-mounted onto it.
ARCHIVE_DIR=/archive
ARCHIVE_DIR_HOST=/data/vat-archive
# Hard cap on total archive size (oldest evicted first). Accepts raw bytes or a
# human suffix: KB/MB/GB/TB (powers of 1024).
ARCHIVE_MAX_BYTES=10GB
# JPEG quality for the full-res archived frames (higher than the transmit copy).
ARCHIVE_JPEG_QUALITY=92

# ── Pose fuser (robot) ──────────────────────────────────────────────────────
PUBLISH_HZ=50.0
FALLBACK_BODY_HEIGHT=0.30
# Which Go2 sport-state topic the fuser/camera track for body height, tilt and
# limb data. The robot publishes the high-rate `sportmodestate` ONLY while the
# motion service is active, but always publishes a low-frequency
# `lf/sportmodestate` (~10 Hz). Default to the always-on lf copy; set to
# `sportmodestate` for the full-rate stream once the dog is up and moving.
SPORT_TOPIC=lf/sportmodestate
# Dead-reckoning odometry: we compute our own from /lowstate (the Go2-W has no
# robot_odom, and lf/sportmodestate.velocity is zeroed). The fuser fuses the IMU
# attitude with WHEEL odometry — the 4 wheel motors' speed × this rolling radius.
# 7-inch tire ≈ 0.089 m nominal; loaded ≈ 0.085 m. CALIBRATE: drive a known
# distance and scale so the dead-reckon matches; flip the sign if it runs backward.
WHEEL_RADIUS=0.085
# Selfie-stick geometry: camera pose in the base frame, metres. MEASURE THESE.
# Camera is straight up on the middle of the dog's back, 80 cm above the body
# origin. X = fore/aft (+forward, tweak if the mount sits behind centre), Z = up.
STICK_OFFSET_X=0.0
STICK_OFFSET_Y=0.0
STICK_OFFSET_Z=0.80
# Camera→base rotation. Default maps PanoVGGT's optical frame (equirect centre =
# forward) to the REP-103 base. If the avatar's heading is rotated vs the cloud,
# nudge STICK_YAW_TRIM_DEG (e.g. 90 / 180 / -90) until they line up.
STICK_MOUNT_RPY_DEG=-90,0,-90
STICK_YAW_TRIM_DEG=0
# Camera height stamped into each frame (drives PRISM's per-submap METRIC SCALE).
# Must be CONSISTENT or the online map misaligns. 'const' = one fixed height for
# every frame (like the gradio run that aligned perfectly); 'legs' = stance-aware
# height from the leg FK ground plane (stable when the dog crouches/stands).
CAMERA_HEIGHT_MODE=const
CAMERA_HEIGHT_M=1.15      # measured ground→camera (standing)

# ── Teleop (robot drive) ────────────────────────────────────────────────────
# The client streams cmd_vel; the robot's teleop_bridge relays it to the Go2
# sport Move API and STOPS the robot if the stream pauses (deadman). Start
# conservative and keep the physical Unitree remote in hand as the hard e-stop.
TELEOP_RATE_HZ=20.0       # cmd_vel stream + relay rate
TELEOP_TIMEOUT_S=0.3      # deadman: no command for this long → StopMove
TELEOP_MAX_VX=0.3         # forward/back clamp (m/s)
TELEOP_MAX_VY=0.2         # strafe clamp (m/s) — limited on the wheeled Go2-W
TELEOP_MAX_VYAW=0.6       # turn-rate clamp (rad/s)

# ── Mapping server batching ─────────────────────────────────────────────────
# Process a PRISM window on (WINDOW_SIZE-OVERLAP) new frames OR this many seconds
# (watchdog), whichever first. 5 s suits the larger 16-frame window.
WINDOW_TIMEOUT_S=5.0
