<launch>
  <!-- ========================================================
       VAT frame_publisher bringup
       ========================================================
       Launches only this node.  Normally composed inside the
       master vat_bringup.launch.xml rather than launched standalone.

       Arguments (all have defaults — override from CLI or parent launch):
         throttle_fps   Target FPS to send to the PRISM server  (default 3.0)
         jpeg_quality   JPEG compression quality 0–100           (default 85)
         zenoh_router   Zenoh router endpoint                    (default localhost)
         robot_name     Zenoh key prefix for the robot           (default go2)
         input_topic    Equirectangular image topic              (default /equirectangular/image)
         output_topic   Output compressed-image topic            (default /prism/camera/frame)
       ======================================================== -->

  <arg name="throttle_fps"  default="3.0"/>
  <arg name="jpeg_quality"  default="85"/>
  <arg name="zenoh_router"  default="tcp/127.0.0.1:7447"/>
  <arg name="robot_name"    default="go2"/>
  <arg name="input_topic"   default="/equirectangular/image"/>
  <arg name="output_topic"  default="/prism/camera/frame"/>

  <node pkg="frame_publisher" exec="frame_publisher_node" name="frame_publisher"
        output="screen">
    <param name="throttle_fps"  value="$(var throttle_fps)"/>
    <param name="jpeg_quality"  value="$(var jpeg_quality)"/>
    <param name="zenoh_router"  value="$(var zenoh_router)"/>
    <param name="robot_name"    value="$(var robot_name)"/>
    <param name="input_topic"   value="$(var input_topic)"/>
    <param name="output_topic"  value="$(var output_topic)"/>
  </node>
</launch>
