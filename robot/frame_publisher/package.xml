<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>frame_publisher</name>
  <version>0.1.0</version>
  <description>
    Subscribes to /equirectangular/image, throttles to a configurable FPS,
    JPEG-compresses each frame, and publishes on /prism/camera/frame for
    the DynamicZenohBridge to stream to the PRISM server.

    Throttle rate is configurable live via Zenoh (go2/rt/prism/config/throttle_fps).
  </description>

  <maintainer email="rafaelfariasm@live.com">Rafael Farias</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Python libs (must be present in the ROS env or installed via pip) -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
