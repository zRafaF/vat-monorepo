# VAT server deployment — copy to `.env` next to docker-compose.yml and fill in.
# DO NOT commit the real .env (it holds your Tailscale auth key).

# ── Tailscale (REQUIRED) ─────────────────────────────────────────────────────
# Create a key: https://login.tailscale.com/admin/settings/keys
# Recommended: Reusable + Non-ephemeral (stable server node), no/long expiry.
# Optionally attach an ACL tag (e.g. tag:vat-server) for pre-approval.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxx
# Name this node shows up as in the Tailscale admin console / MagicDNS.
TS_HOSTNAME=vat-server

# ── Repo to deploy ───────────────────────────────────────────────────────────
GIT_REPO_URL=https://github.com/zRafaF/vat-monorepo.git
GIT_REF=main
# PRIVATE repo? Embed a token (or use a fine-grained PAT / deploy token):
# GIT_REPO_URL=https://<user>:<token>@github.com/zRafaF/vat-monorepo.git

# ── Zenoh ────────────────────────────────────────────────────────────────────
ROUTER_PORT=7447

# ── Container root password (host-port :2222 SSH fallback only) ──────────────
ROOT_PASSWORD=lab_password
